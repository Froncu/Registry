{
   "version": 3,
   "configurePresets": [
      {
         "name": "registry_base",
         "hidden": true,
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "toolchainFile": "${sourceDir}/registry/vcpkg/scripts/buildsystems/vcpkg.cmake",
         "cacheVariables": {
            "VCPKG_MANIFEST_DIR": "${sourceDir}",
            "VCPKG_OVERLAY_PORTS": "${sourceDir}/registry/ports",
            "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/registry/internal",
            "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/registry/internal/llvm.cmake",
            "VCPKG_HOST_TRIPLET": "triplet",
            "VCPKG_TARGET_TRIPLET": "triplet"
         }
      }
   ]
}