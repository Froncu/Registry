{
   "version": 4,
   "configurePresets": [
      {
         "name": "clang",
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "toolchainFile": "${fileDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
         "cacheVariables": {
            "VCPKG_MANIFEST_DIR": "${sourceDir}",
            "VCPKG_OVERLAY_PORTS": "${fileDir}/ports",
            "VCPKG_OVERLAY_TRIPLETS": "${fileDir}/triplets",
            "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${fileDir}/toolchains/clang.cmake",
            "VCPKG_HOST_TRIPLET": "x64-clang",
            "VCPKG_TARGET_TRIPLET": "x64-clang"
         }
      }
   ]
}